<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN, USB, and two VMs use HTTP. Internet is not required. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
