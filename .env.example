# Backend
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Apify — leave empty to use mock scraper data
APIFY_API_TOKEN=
APIFY_ACTOR_ID=curious_coder/linkedin-jobs-scraper

# OpenAI — leave empty to use heuristic AI ranking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL — leave empty to use local JSON persistence
DATABASE_URL=postgresql://jobuser:jobpass@localhost:5432/jobdiscovery

# Redis — leave empty to use in-memory cache
REDIS_URL=redis://localhost:6379

# Cache TTL (seconds)
CACHE_TTL_SECONDS=3600

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Portal / digests (Railway)
JWT_SECRET=change-me-to-a-long-random-string
TELEGRAM_BOT_TOKEN=
# Optional — auto-detected from getMe if empty
TELEGRAM_BOT_USERNAME=
DIGEST_CRON=0 5 * * *
DIGEST_TIMEZONE=Asia/Kolkata
DIGEST_TOP_N=5
PUBLIC_APP_URL=http://localhost:3000
