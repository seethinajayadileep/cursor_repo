# InterviewPilot AI environment variables
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development
PORT=8787
CORS_ORIGIN=http://localhost:5173

# SQLite for local/desktop; use postgres://... for cloud
DATABASE_URL=file:data/sqlite/interviewpilot.db

# Change in any shared/deployed environment
AUTH_SECRET=replace-with-long-random-string

# demo | openai | anthropic | google | local
AI_PROVIDER=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# demo | browser | local | cloud
STT_PROVIDER=demo
STT_API_KEY=

# Force demo even if keys exist
DEMO_MODE=true

MAX_UPLOAD_MB=10

# Desktop
INTERVIEWPILOT_WEB_URL=http://localhost:5173
