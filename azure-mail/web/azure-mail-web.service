[Unit]
Description=Mailbox brand panel (multi-provider)
After=network.target docker.service

[Service]
Type=simple
User=root
Environment=AZURE_MAIL_ENV=/etc/azure-mail/brand.env
Environment=AZURE_MAIL_PROVIDERS=/etc/azure-mail/providers.json
Environment=PYTHONPATH=/usr/local/lib/azure-mail
Environment=WEB_PREFIX=/brands
Environment=WEB_HOST=0.0.0.0
Environment=WEB_PORT=8787
WorkingDirectory=/usr/local/lib/azure-mail/web
ExecStart=/usr/local/lib/azure-mail/venv/bin/python /usr/local/lib/azure-mail/web/app.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
